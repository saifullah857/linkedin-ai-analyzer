# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-64-char-string
SESSION_TYPE=filesystem

# Database
# Leave unset to use the built-in default (an absolute path under
# ./instance/database/app.db -- see config.py). Only set this if you want
# a different database (Postgres, MySQL, etc.) or a custom sqlite location.
# If you do set a sqlite:/// path here, config.py will resolve it to an
# absolute path automatically -- Flask-SQLAlchemy resolves relative sqlite
# paths against app.instance_path, not this file's location, which silently
# breaks a plain relative path like "sqlite:///instance/database/app.db".
# DATABASE_URL=sqlite:///instance/database/app.db

# Uploads
UPLOAD_FOLDER=uploads
REPORTS_FOLDER=reports
MAX_CONTENT_LENGTH_MB=10

# NOTE: We never store a Groq API key here.
# Every user supplies their own Groq API key at runtime through the UI.
# It lives only in the Flask session for that browser session and is
# never written to disk or to the database.

# Rate limiting
RATE_LIMIT_DEFAULT=100 per hour
